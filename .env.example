INTAKE_ML_SERVICE_URL=http://localhost:8002
INTAKE_ML_TIMEOUT_MS=90000

# Existing general/emotion ML deployment; keep its current value in Render.
ML_SERVICE_URL=http://localhost:8001
EMOTION_ML_SERVICE_URL=http://localhost:8001
EMOTION_CONFIDENCE_THRESHOLD=0.35

# Service that implements POST /predict/medicine-safety.
# Set this to ML Service 2 only if that route appears in its /docs page.
MEDICINE_SAFETY_ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_MS=60000

# Hosted Node services must never try to launch local Python processes.
ML_SERVICE_AUTO_START=false
EMOTION_ML_SERVICE_AUTO_START=false
